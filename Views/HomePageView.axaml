<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIShikikan.Gui.ViewModels"
             xmlns:v="using:AIShikikan.Gui.Views"
             xmlns:usage="using:AIShikikan.Core.Services.Usage"
             xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             xmlns:res="clr-namespace:AIShikikan.Gui.Resources"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AIShikikan.Gui.Views.HomePageView"
             x:DataType="vm:HomePageViewModel">

    <UserControl.Resources>
        <v:ModelListVisibilityConverter x:Key="ModelListVisibilityConverter"/>
        <v:IntEqualsConverter x:Key="IntEqualsConverter"/>
    </UserControl.Resources>

    <Grid>
        <v:PageBackground ThemeService="{Binding ThemeService}" />

        <ScrollViewer>
            <StackPanel Margin="24,16" Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border CornerRadius="12" ClipToBounds="True" VerticalAlignment="Center">
                            <Image Source="avares://AIShikikan.Gui/Assets/logo.jpg" Width="64" Height="64"
                                   Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Classes="HeadlineSmall" Text="{x:Static res:Strings.Home_Welcome}" />
                            <TextBlock Classes="BodyMedium" Text="{x:Static res:Strings.Home_Description}"
                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                            <TextBlock Classes="BodySmall" Text="{Binding VersionText}"
                                       Foreground="{DynamicResource OnSurfaceVariant}" Opacity="0.7" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 全局时间范围: 同时作用于用量趋势与活跃热力图 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="BodyMedium" Text="{x:Static res:Strings.Home_UsageRange}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnSurfaceVariant}" />
                        <ComboBox ItemsSource="{Binding RangeOptions}"
                                  SelectedIndex="{Binding SelectedRangeIndex}"
                                  MinWidth="88" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 用量统计: 左右两张卡片 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <!-- 左卡片: 汇总数字 + 分布 -->
                    <theme:Card Classes="Elevated">
                        <StackPanel Margin="18,14" Spacing="10">
                            <TextBlock Classes="TitleMedium" Text="{x:Static res:Strings.Home_UsageTitle}" />

                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="1">
                                    <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Home_UsageToday}"
                                               Foreground="{DynamicResource OnSurfaceVariant}" />
                                    <TextBlock Classes="BodyMedium" Text="{Binding TodayUsageText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Home_UsageTotal}"
                                               Foreground="{DynamicResource OnSurfaceVariant}" />
                                    <TextBlock Classes="BodyMedium" Text="{Binding TotalUsageText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Home_UsageLlmCalls}"
                                               Foreground="{DynamicResource OnSurfaceVariant}" />
                                    <TextBlock Classes="BodyMedium" Text="{Binding LlmCallsText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="1">
                                    <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Home_UsageAgentCalls}"
                                               Foreground="{DynamicResource OnSurfaceVariant}" />
                                    <TextBlock Classes="BodyMedium" Text="{Binding AgentCallsText}" />
                                </StackPanel>
                            </Grid>

                            <theme:Divider />

                            <TextBlock Classes="TitleSmall" Text="{x:Static res:Strings.Home_UsageByModel}" />
                            <ItemsControl ItemsSource="{Binding UsageSnapshot.ModelStats}"
                                          IsVisible="{Binding UsageSnapshot.ModelStats.Count, Converter={StaticResource ModelListVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="usage:ModelUsageStat">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Margin="0,1">
                                            <TextBlock Classes="BodyMedium" Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Classes="BodySmall"
                                                       Text="{Binding Calls, StringFormat={}{0} 次调用}"
                                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                                            <TextBlock Grid.Column="2" Classes="BodySmall"
                                                       Text="{Binding TotalTokens, StringFormat={}{0:N0} tokens}"
                                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Home_UsageEmpty}"
                                       Foreground="{DynamicResource OnSurfaceVariant}"
                                       IsVisible="{Binding UsageSnapshot.ModelStats.Count, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}" />

                            <TextBlock Classes="TitleSmall" Text="{x:Static res:Strings.Home_UsageBySession}" />
                            <ItemsControl ItemsSource="{Binding UsageSnapshot.SessionStats}"
                                          IsVisible="{Binding UsageSnapshot.SessionStats.Count, Converter={StaticResource ModelListVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="usage:SessionUsageStat">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Margin="0,1">
                                            <TextBlock Classes="BodyMedium" Text="{Binding SessionTitle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Classes="BodySmall"
                                                       Text="{Binding Calls, StringFormat={}{0} 次调用}"
                                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                                            <TextBlock Grid.Column="2" Classes="BodySmall"
                                                       Text="{Binding TotalTokens, StringFormat={}{0:N0} tokens}"
                                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Home_UsageEmpty}"
                                       Foreground="{DynamicResource OnSurfaceVariant}"
                                       IsVisible="{Binding UsageSnapshot.SessionStats.Count, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}" />

                            <TextBlock Classes="TitleSmall" Text="{x:Static res:Strings.Home_UsageByAgent}" />
                            <ItemsControl ItemsSource="{Binding UsageSnapshot.AgentStats}"
                                          IsVisible="{Binding UsageSnapshot.AgentStats.Count, Converter={StaticResource ModelListVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="usage:AgentCallStat">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Margin="0,1">
                                            <TextBlock Classes="BodyMedium" Text="{Binding AgentName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Classes="BodySmall"
                                                       Text="{Binding Calls, StringFormat={}{0} 次调用}"
                                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                                            <TextBlock Grid.Column="2" Classes="BodySmall"
                                                       Text="{Binding Succeeded, StringFormat={}成功 {0} 次}"
                                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Home_UsageEmpty}"
                                       Foreground="{DynamicResource OnSurfaceVariant}"
                                       IsVisible="{Binding UsageSnapshot.AgentStats.Count, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}" />
                        </StackPanel>
                    </theme:Card>

                    <!-- 右卡片: 用量趋势折线图(时间范围由主页顶部全局选择器控制) -->
                    <theme:Card Classes="Elevated" Grid.Column="1" VerticalAlignment="Top">
                        <StackPanel Margin="18,14" Spacing="10">
                            <TextBlock Classes="TitleMedium" Text="{x:Static res:Strings.Home_UsageTrend}" />

                            <Panel IsVisible="{Binding HasChartData}">
                                <ScottPlot:AvaPlot x:Name="UsageChart" Height="230"
                                                   PointerMoved="OnChartPointerMoved"
                                                   PointerExited="OnChartPointerExited"/>
                                <!-- 悬浮详情覆盖层: Canvas 不参与布局测量, 不影响卡片尺寸 -->
                                <Canvas x:Name="ChartTipLayer" IsHitTestVisible="False">
                                    <Border x:Name="ChartTip" IsVisible="False" Padding="12,9"
                                            CornerRadius="8">
                                        <TextBlock x:Name="ChartTipText" FontSize="12"
                                                   TextWrapping="NoWrap"/>
                                    </Border>
                                </Canvas>
                            </Panel>

                            <!-- 自绘图例: 底色随卡片主题, 条目含 总量/命中/未命中 说明 -->
                            <ItemsControl ItemsSource="{Binding LegendItems}"
                                          IsVisible="{Binding HasChartData}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="20"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChartLegendItemVm">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Border Width="10" Height="10" CornerRadius="2"
                                                    Background="{Binding Swatch}" VerticalAlignment="Center"/>
                                            <TextBlock Classes="BodyMedium" Text="{Binding Name}"/>
                                            <TextBlock Classes="BodySmall" Text="{Binding Note}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource OnSurfaceVariant}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Home_UsageEmpty}"
                                       Foreground="{DynamicResource OnSurfaceVariant}"
                                       IsVisible="{Binding !HasChartData}" HorizontalAlignment="Center"
                                       Margin="0,70,0,0" />
                        </StackPanel>
                    </theme:Card>
                </Grid>

                <!-- 活跃热力图: 范围随主页全局时间范围, 格子自适应拉伸 -->
                <theme:Card Classes="Elevated">
                    <StackPanel Margin="18,14" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="TitleMedium" Text="{x:Static res:Strings.Home_ActivityTitle}"/>
                            <TextBlock Grid.Column="1" Classes="BodySmall" Text="{Binding HeatRangeText}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariant}"/>
                        </Grid>

                        <ScrollViewer x:Name="HeatScroll" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding UsageSnapshot.DailyStats.Count, Converter={StaticResource ModelListVisibilityConverter}}">
                            <!-- 宽度跟随视口: 格子均分拉伸填满; MinWidth 由面板按列数同步, 窄视口时出滚动条 -->
                            <v:HeatmapGridPanel x:Name="HeatGrid"
                                                Width="{Binding #HeatScroll.Viewport.Width}"
                                                MinWidth="{Binding HeatmapMinWidth}"
                                                Columns="{Binding HeatmapColumns}"
                                                CellSpacing="3" MaxCellSize="30" MinCellSize="8" GutterWidth="18"/>
                        </ScrollViewer>

                        <!-- 图例: 少 → 多 -->
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Home_HeatLess}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariant}"/>
                            <ItemsControl ItemsSource="{Binding HeatLegend}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HeatmapLegendVm">
                                        <Border Width="11" Height="11" CornerRadius="3"
                                                Background="{Binding Brush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Home_HeatMore}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariant}"/>
                        </StackPanel>

                        <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Home_UsageEmpty}"
                                   Foreground="{DynamicResource OnSurfaceVariant}" HorizontalAlignment="Center"
                                   IsVisible="{Binding UsageSnapshot.DailyStats.Count, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"/>
                    </StackPanel>
                </theme:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
