<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIShikikan.Gui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             xmlns:res="clr-namespace:AIShikikan.Gui.Resources"
             xmlns:local="using:AIShikikan.Gui.Views"
             xmlns:llm="using:AIShikikan.Core.Services.Llm"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AIShikikan.Gui.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibilityConverter"/>
        <local:FetchingToTextConverter x:Key="FetchingToTextConverter"/>
        <local:IntEqualsConverter x:Key="IntEqualsConverter"/>
        <local:ThinkingLevelToTextConverter x:Key="ThinkingLevelToTextConverter"/>
    </UserControl.Resources>

    <Grid>
        <local:PageBackground ThemeService="{Binding ThemeService}" />

        <ScrollViewer>
        <StackPanel Margin="32,24" Spacing="24">
            <TextBlock Classes="DisplaySmall" Text="{x:Static res:Strings.Settings_Title}" />

            <!-- 外观设置 -->
            <theme:Card Classes="Outlined" MaxWidth="600">
                <StackPanel>
                    <TextBlock Classes="TitleMedium" Text="{x:Static res:Strings.Settings_Appearance}" Margin="24,16,24,0" />
                    <StackPanel Margin="24,16" Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="BodyLarge" Text="{x:Static res:Strings.Settings_DarkTheme}" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkTheme}" />
                        </Grid>
                        <theme:Divider />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Classes="BodyLarge" Text="{x:Static res:Strings.Settings_Language}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding LanguageIndex}"
                                      ItemsSource="{Binding LanguageOptions}" MinWidth="120" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="BodySmall"
                                       Text="{x:Static res:Strings.Settings_RestartHint}"
                                       IsVisible="{Binding IsRestartHintVisible}"
                                       Foreground="{DynamicResource Primary}" Margin="0,8,0,0" />
                        </Grid>
                        <theme:Divider />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Classes="BodyLarge" Text="{x:Static res:Strings.Settings_FontStandard}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedStandardFontIndex}"
                                      ItemsSource="{Binding StandardFontOptions}" MinWidth="200" />
                            <TextBox Grid.Row="1" Grid.ColumnSpan="2" Width="220" Margin="0,8,0,0"
                                     PlaceholderText="{x:Static res:Strings.Settings_FontCustomStandard}"
                                     Text="{Binding StandardCustomFontText}"
                                     IsVisible="{Binding SelectedStandardFontIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" />
                        </Grid>
                        <theme:Divider />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Classes="BodyLarge" Text="{x:Static res:Strings.Settings_FontMono}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedMonoFontIndex}"
                                      ItemsSource="{Binding MonoFontOptions}" MinWidth="200" />
                            <TextBox Grid.Row="1" Grid.ColumnSpan="2" Width="220" Margin="0,8,0,0"
                                     PlaceholderText="{x:Static res:Strings.Settings_FontCustomMono}"
                                     Text="{Binding MonoCustomFontText}"
                                     IsVisible="{Binding SelectedMonoFontIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" />
                        </Grid>
                        <theme:Divider />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Classes="BodyLarge" Text="{x:Static res:Strings.Settings_Background}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="FilledTonal" Content="{x:Static res:Strings.Settings_SelectBg}"
                                        Command="{Binding SelectBackgroundCommand}" />
                                <Button Classes="Outlined" Content="{x:Static res:Strings.Settings_ClearBg}"
                                        Command="{Binding ClearBackgroundCommand}" />
                            </StackPanel>
                            <Image Grid.Row="1" Grid.ColumnSpan="2"
                                   Source="{Binding BackgroundPreview}"
                                   MaxHeight="120" MaxWidth="400"
                                   IsVisible="{Binding HasBackground}"
                                   Margin="0,8,0,0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </theme:Card>

            <!-- LLM 提供商 -->
            <theme:Card Classes="Outlined" MaxWidth="600">
                <StackPanel>
                    <TextBlock Classes="TitleMedium" Text="{x:Static res:Strings.Settings_Providers}" Margin="24,16,24,0" />
                    <StackPanel Margin="24,16" Spacing="16">
                        <ListBox ItemsSource="{Binding ProviderItems}" SelectedItem="{Binding SelectedProvider}"
                                 MaxHeight="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" Classes="BodyMedium"/>
                                        <TextBlock Text="{Binding Id}" Classes="LabelSmall"
                                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                                        <TextBlock Text="{Binding Kind}" Classes="LabelSmall"
                                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Classes="Text" Content="{x:Static res:Strings.Settings_Remove}"
                                Command="{Binding RemoveProviderCommand}" CommandParameter="{Binding SelectedProvider}"
                                HorizontalAlignment="Right"/>
                        <theme:Divider />
                        <StackPanel Spacing="8" IsVisible="{Binding SelectedProvider, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="TitleSmall" Text="{x:Static res:Strings.Settings_ModelsTitle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="FilledTonal" Content="{Binding IsFetchingModels, Converter={StaticResource FetchingToTextConverter}}"
                                            Command="{Binding FetchModelsCommand}" IsEnabled="{Binding !IsFetchingModels}" />
                                    <Button Classes="Text" Content="{x:Static res:Strings.Settings_EnableAll}"
                                            Command="{Binding EnableAllModelsCommand}" />
                                    <Button Classes="Text" Content="{x:Static res:Strings.Settings_DisableAll}"
                                            Command="{Binding DisableAllModelsCommand}" />
                                    <Button Classes="Text" Content="{x:Static res:Strings.Settings_DetectThinking}"
                                            Command="{Binding DetectThinkingLevelsCommand}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="BodySmall" Text="{Binding ModelFetchError}"
                                       Foreground="{DynamicResource Error}"
                                       IsVisible="{Binding ModelFetchError, Converter={StaticResource NotEmptyToVisibilityConverter}}"
                                       TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <TextBlock Classes="LabelSmall" Text="{x:Static res:Strings.Settings_ModelNameHeader}"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                                <TextBlock Grid.Column="1" Classes="LabelSmall" Text="{x:Static res:Strings.Settings_MaxThinking}"
                                           Foreground="{DynamicResource OnSurfaceVariant}"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding ModelItems}" MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Id}" Classes="BodyMedium"
                                                       VerticalAlignment="Center" Margin="8,0,8,0"/>
                                            <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:ModelItem.LevelOptions}"
                                                      SelectedItem="{Binding MaxThinking}" MinWidth="84">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="llm:ThinkingLevel">
                                                        <TextBlock Text="{Binding, Converter={StaticResource ThinkingLevelToTextConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="BodyLarge" Text="{x:Static res:Strings.Settings_ProviderDefaultModel}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" MinWidth="200" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding ModelItems}"
                                          SelectedItem="{Binding SelectedDefaultModelItem}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Id}" Classes="BodyMedium" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                        <theme:Divider />
                        <TextBlock Classes="TitleSmall" Text="{x:Static res:Strings.Settings_ProviderAdd}" />
                        <StackPanel Spacing="8">
                            <TextBox PlaceholderText="{x:Static res:Strings.Settings_ProviderName}"
                                     Text="{Binding NewProviderName}" />
                            <TextBox PlaceholderText="https://api.example.com/v1"
                                     Text="{Binding NewProviderBaseUrl}" />
                            <TextBox
                                     Text="{Binding NewProviderApiKey}"
                                     PlaceholderText="{x:Static res:Strings.Settings_ProviderApiKey}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox SelectedIndex="{Binding NewProviderModelSourceIndex}"
                                          ItemsSource="{Binding NewProviderModelSourceOptions}"
                                          HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Classes="FilledTonal" Margin="8,0,0,0"
                                        Content="{Binding IsFetchingNewProviderModels, Converter={StaticResource FetchingToTextConverter}}"
                                        Command="{Binding FetchNewProviderModelsCommand}"
                                        IsEnabled="{Binding !IsFetchingNewProviderModels}"/>
                            </Grid>
                            <TextBlock Classes="BodySmall" Text="{Binding NewProviderModelError}"
                                       Foreground="{DynamicResource Error}"
                                       IsVisible="{Binding NewProviderModelError, Converter={StaticResource NotEmptyToVisibilityConverter}}"
                                       TextWrapping="Wrap" />
                            <ComboBox PlaceholderText="{x:Static res:Strings.Settings_ProviderModel}"
                                      Text="{Binding NewProviderCustomModel}"
                                      ItemsSource="{Binding NewProviderFetchedModels}"
                                      IsVisible="{Binding NewProviderModelSourceIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"/>
                            <TextBox PlaceholderText="{x:Static res:Strings.Settings_ProviderModelCustom}"
                                     Text="{Binding NewProviderCustomModel}"
                                     IsVisible="{Binding NewProviderModelSourceIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"/>
                            <ComboBox PlaceholderText="{x:Static res:Strings.Settings_ProviderKind}"
                                      SelectedIndex="{Binding NewProviderKindIndex}"
                                      ItemsSource="{Binding ProviderKindOptions}"/>
                            <Button Classes="Filled" Content="{x:Static res:Strings.Settings_Add}"
                                    Command="{Binding AddProviderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </theme:Card>

            <!-- Agent 程序 -->
            <theme:Card Classes="Outlined" MaxWidth="600">
                <StackPanel>
                    <TextBlock Classes="TitleMedium" Text="{x:Static res:Strings.Settings_Agents}" Margin="24,16,24,0" />
                    <StackPanel Margin="24,16" Spacing="16">
                        <ListBox ItemsSource="{Binding UserAgents}" SelectedItem="{Binding SelectedAgent}" MaxHeight="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" Classes="BodyMedium"/>
                                        <TextBlock Text="{Binding Executable}" Classes="LabelSmall"
                                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Spacing="8" IsVisible="{Binding SelectedAgent, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Text="{Binding AgentExecutableEdit}"
                                         PlaceholderText="{x:Static res:Strings.Settings_AgentExecutable}" />
                                <Button Grid.Column="1" Classes="FilledTonal" Margin="8,0,0,0"
                                        Content="{x:Static res:Strings.Settings_AgentSave}"
                                        Command="{Binding SaveAgentExecutableCommand}" />
                                <Button Grid.Column="2" Classes="Text" Margin="8,0,0,0"
                                        Content="{x:Static res:Strings.Settings_Remove}"
                                        Command="{Binding RemoveAgentCommand}"
                                        CommandParameter="{Binding SelectedAgent}" />
                            </Grid>
                            <TextBox Text="{Binding AgentArgsEdit}"
                                     PlaceholderText="{x:Static res:Strings.Settings_AgentArgsPlaceholder}" />
                            <TextBlock Classes="BodySmall" Text="{x:Static res:Strings.Settings_AgentEditHint}"
                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                        </StackPanel>
                        <theme:Divider />
                        <StackPanel Spacing="8">
                            <TextBox PlaceholderText="{x:Static res:Strings.Settings_AgentName}"
                                     Text="{Binding NewAgentName}" />
                            <TextBox PlaceholderText="{x:Static res:Strings.Settings_AgentExecutable}"
                                     Text="{Binding NewAgentExecutable}" />
                            <TextBox PlaceholderText="{x:Static res:Strings.Settings_AgentArgsPlaceholder}"
                                     Text="{Binding NewAgentArgs}" />
                            <Button Classes="Filled" Content="{x:Static res:Strings.Settings_Add}"
                                    Command="{Binding AddAgentCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </theme:Card>

            <!-- 关于 -->
            <theme:Card Classes="Outlined" MaxWidth="600">
                <StackPanel>
                    <TextBlock Classes="TitleMedium" Text="{x:Static res:Strings.Settings_About}" Margin="24,16,24,0" />
                    <StackPanel Margin="24,16" Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Classes="BodyLarge" Text="{x:Static res:Strings.Settings_AppName}" Grid.Row="0" Grid.Column="0"
                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                            <TextBlock Classes="BodyLarge" Text="{Binding AppName}" Grid.Row="0" Grid.Column="1" />
                            <TextBlock Classes="BodyLarge" Text="{x:Static res:Strings.Settings_Version}" Grid.Row="1" Grid.Column="0"
                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                            <TextBlock Classes="BodyLarge" Text="{Binding AppVersion}" Grid.Row="1" Grid.Column="1" />
                            <TextBlock Classes="BodyLarge" Text="{x:Static res:Strings.Settings_FontStandard}" Grid.Row="2" Grid.Column="0"
                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                            <TextBlock Classes="BodyLarge" Text="{Binding FontInfo}" Grid.Row="2" Grid.Column="1" />
                            <TextBlock Classes="BodyLarge" Text="{x:Static res:Strings.Settings_FontMono}" Grid.Row="3" Grid.Column="0"
                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                            <TextBlock Classes="BodyLarge" Text="{Binding MonoFontInfo}" Grid.Row="3" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </theme:Card>
        </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>