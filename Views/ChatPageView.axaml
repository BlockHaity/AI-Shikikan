<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIShikikan.Gui.ViewModels"
             xmlns:v="using:AIShikikan.Gui.Views"
             xmlns:llm="using:AIShikikan.Core.Services.Llm"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:AIShikikan.Gui.Resources"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AIShikikan.Gui.Views.ChatPageView"
             x:DataType="vm:ChatPageViewModel">

    <UserControl.Resources>
        <v:ThinkingLevelToTextConverter x:Key="ThinkingLevelToTextConverter"/>
        <StreamGeometry x:Key="IconChevronRight">M9.29,6.71a1,1,0,0,0,0,1.41L13.17,12l-3.88,3.88a1,1,0,1,0,1.41,1.41l4.59-4.59a1,1,0,0,0,0-1.41L10.7,6.71A1,1,0,0,0,9.29,6.71Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M7.41,8.59L12,13.17l4.59-4.58L18,10l-6,6l-6-6L7.41,8.59Z</StreamGeometry>
        <StreamGeometry x:Key="IconBulb">M17.66,8.34A6,6 0 0,1 15,18H9A6,6 0 0,1 6.34,8.34C7.5,7.18 8,5.63 8,4A1,1 0 0,1 9,3C10,3 10.53,3.51 11,4C11.47,3.51 12,3 13,3A1,1 0 0,1 14,4C14,5.63 14.5,7.18 15.66,8.34M8,19H16V20A1,1 0 0,1 15,21H9A1,1 0 0,1 8,20V19M14,17H10V18H14V17Z</StreamGeometry>
        <StreamGeometry x:Key="IconCaretRight">M8.59,7.41L10,6l6,6l-6,6l-1.41-1.41L13.17,12L8.59,7.41Z</StreamGeometry>
        <StreamGeometry x:Key="IconCaretLeft">M15.41,7.41L14,6l-6,6l6,6l1.41-1.41L10.83,12L15.41,7.41Z</StreamGeometry>
        <StreamGeometry x:Key="IconSmartToySmall">M22,9v6c0,1.1-0.9,2-2,2h-1v2c0,1.1-0.9,2-2,2H7c-1.1,0-2-0.9-2-2v-2H4c-1.1,0-2-0.9-2-2V9c0-1.1,0.9-2,2-2h1V5c0-1.1,0.9-2,2-2h10c1.1,0,2,0.9,2,2v2h1C21.1,7,22,7.9,22,9zM8,13h6v-2H8V13zM18,11h-2v2h2V11zM19,7h-2v2h2V7zM20,9h-2v2h2V9z</StreamGeometry>
        <StreamGeometry x:Key="IconSourceTree">M22,6c0-1.66,1.34-3,3-3s3,1.34,3,3s-1.34,3-3,3c-0.42,0-0.81-0.09-1.17-0.24l-3.83,5.11c0.52,0.93,0.82,2.01,0.82,3.13h2c1.1,0,2,0.9,2,2s-0.9,2-2,2h-2c-1.1,0-2-0.9-2-2v-8.12l-3.1,0.31c0.06,0.26,0.1,0.53,0.1,0.81v2.83c1.16,0.41,2,1.52,2,2.82c0,1.66-1.34,3-3,3s-3-1.34-3-3c0-1.3,0.84-2.4,2-2.81V19.1c0-0.42,0.04-0.84,0.12-1.24c-1.09-0.22-1.92-1.2-1.92-2.36v-1.87c-1.16-0.41-2-1.52-2-2.81c0-1.66,1.34-3,3-3s3,1.34,3,3c0,1.3-0.84,2.4-2,2.81v1.87c0,0.28,0.22,0.5,0.5,0.5h4.16L18.83,7.83C18.32,7.6,18,6.84,18,6c0-1.66,1.34-3,3-3S22,4.34,22,6z</StreamGeometry>
        <StreamGeometry x:Key="IconAssessment">M19,3H5C3.9,3 3,3.9 3,5v14c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2V5C21,3.9 20.1,3 19,3zM9,17H7v-7h2V17zM13,17h-2V7h2V17zM17,17h-2v-4h2V17z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.railBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style Selector="Button.railBtn.active">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
        </Style>
    </UserControl.Styles>

    <Grid>

        <v:PageBackground ThemeService="{Binding ThemeService}" ScrimOpacity="0.7" />

        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

        <!-- 会话列表侧栏(最左侧) -->
        <Border Grid.Column="0" Width="220" BorderBrush="{DynamicResource OutlineVariant}"
                BorderThickness="0,0,1,0" Background="{DynamicResource SurfaceContainerLow}">
            <ContentControl Content="{Binding SessionPanel}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:SessionPanelViewModel">
                        <v:SessionPanelView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>

        <!-- 聊天区 -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto">

            <Border Grid.Row="0" Padding="16,8" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="TitleSmall" VerticalAlignment="Center"
                               Text="{Binding ActiveModelText}" TextTrimming="CharacterEllipsis"/>
                    <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider}"
                              MinWidth="140" VerticalAlignment="Center"
                              PlaceholderText="{x:Static res:Strings.Chat_SelectProvider}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="llm:ProviderConfig">
                                <TextBlock Text="{Binding Name}" Classes="BodyMedium" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}"
                              MinWidth="180" VerticalAlignment="Center"
                              PlaceholderText="{x:Static res:Strings.Chat_SelectModel}" />
                    <Button Classes="Text" Content="{x:Static res:Strings.Chat_ClearSession}"
                            Command="{Binding ClearMessagesCommand}" IsEnabled="{Binding !IsSending}"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="MessageScroller" Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Messages}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatItemViewModel">
                            <Panel>
                                <!-- 用户消息: 满宽 + 浅色背景, 右对齐正文 -->
                                <Border IsVisible="{Binding IsUser}" Margin="0,4"
                                        Padding="16,10" CornerRadius="8"
                                        Background="{DynamicResource SurfaceContainerHigh}"
                                        HorizontalAlignment="Stretch">
                                    <SelectableTextBlock Classes="BodyMedium"
                                                         Text="{Binding UserBody}"
                                                         TextWrapping="Wrap"
                                                         HorizontalAlignment="Right"/>
                                </Border>

                                <!-- AI 消息: 无气泡, 分段堆叠 (思考/工具卡片 + 正文 markdown) -->
                                <StackPanel IsVisible="{Binding !IsUser}" Spacing="6" Margin="0,4">
                                    <ItemsControl ItemsSource="{Binding Segments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SegmentItemViewModel">
                                                <Panel>
                                                    <!-- 正文 Markdown -->
                                                    <md:MarkdownScrollViewer IsVisible="{Binding IsText}"
                                                                             Markdown="{Binding BodyContent}"
                                                                             Padding="0">
                                                        <md:MarkdownScrollViewer.Styles>
                                                            <StyleInclude Source="avares://AIShikikan.Gui/Resources/MarkdownTheme.axaml"/>
                                                        </md:MarkdownScrollViewer.Styles>
                                                    </md:MarkdownScrollViewer>

                                                    <!-- 思考过程折叠卡片 -->
                                                    <Expander IsVisible="{Binding IsThinking}"
                                                              IsExpanded="{Binding IsExpanded}"
                                                              Margin="0,2">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Classes="BodySmall" Text="{Binding CardGlyph}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Classes="LabelLarge" Text="{Binding CardTitle}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <Border Padding="8" Background="{DynamicResource SurfaceContainerLow}"
                                                                CornerRadius="4">
                                                            <SelectableTextBlock Classes="BodySmall"
                                                                                 Text="{Binding ThinkingContent}"
                                                                                 TextWrapping="Wrap"/>
                                                        </Border>
                                                    </Expander>

                                                    <!-- 工具调用折叠卡片 -->
                                                    <Expander IsVisible="{Binding IsTool}"
                                                              IsExpanded="{Binding IsExpanded}"
                                                              Margin="0,2">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Classes="BodySmall" Text="{Binding CardGlyph}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Classes="LabelLarge" Text="{Binding CardTitle}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <Border Padding="8" Background="{DynamicResource SurfaceContainerLow}"
                                                                CornerRadius="4">
                                                            <StackPanel Spacing="6">
                                                                <!-- 参数: 可读 Markdown / JSON 代码块 切换 -->
                                                                <DockPanel>
                                                                    <TextBlock Classes="LabelSmall" Text="参数"
                                                                               Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                    <Button DockPanel.Dock="Right" Classes="Text"
                                                                            Content="{Binding ArgumentsToggleText}"
                                                                            Command="{Binding ToggleArgumentsViewCommand}"
                                                                            FontSize="11"/>
                                                                </DockPanel>
                                                                <md:MarkdownScrollViewer Markdown="{Binding ArgumentsDisplay}">
                                                                    <md:MarkdownScrollViewer.Styles>
                                                                        <StyleInclude Source="avares://AIShikikan.Gui/Resources/MarkdownTheme.axaml"/>
                                                                    </md:MarkdownScrollViewer.Styles>
                                                                </md:MarkdownScrollViewer>

                                                                <!-- 流式输出 -->
                                                                <StackPanel IsVisible="{Binding HasToolOutput}">
                                                                    <TextBlock Classes="LabelSmall" Text="输出"
                                                                               Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                    <SelectableTextBlock Classes="BodySmall"
                                                                                         Text="{Binding ToolOutput}"
                                                                                         TextWrapping="Wrap"/>
                                                                </StackPanel>

                                                                <!-- 最终结果 -->
                                                                <StackPanel IsVisible="{Binding HasToolResult}">
                                                                    <TextBlock Classes="LabelSmall" Text="结果"
                                                                               Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                    <md:MarkdownScrollViewer Markdown="{Binding ToolResult}">
                                                                        <md:MarkdownScrollViewer.Styles>
                                                                            <StyleInclude Source="avares://AIShikikan.Gui/Resources/MarkdownTheme.axaml"/>
                                                                        </md:MarkdownScrollViewer.Styles>
                                                                    </md:MarkdownScrollViewer>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </Expander>
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 工具栏: 思考深度 / 工作目录 / Plan-Build 模式 -->
            <Border Grid.Row="2" Padding="12,4" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource SurfaceContainerLow}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <!-- 思考档位: 单按钮 + 展开菜单 -->
                    <Button x:Name="ThinkingButton" Classes="Outlined" IsEnabled="{Binding !IsSending}" MinWidth="92"
                            ToolTip.Tip="{x:Static res:Strings.Chat_Thinking}">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ListBox x:Name="ThinkingList" ItemsSource="{Binding ThinkingOptions}"
                                         SelectedItem="{Binding SelectedThinking, Mode=TwoWay}"
                                         SelectionChanged="OnThinkingSelected"
                                         MinWidth="150" MaxHeight="240">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="llm:ThinkingLevel">
                                            <TextBlock Classes="BodyMedium"
                                                       Text="{Binding, Converter={StaticResource ThinkingLevelToTextConverter}}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconBulb}" Width="14" Height="14"/>
                            <TextBlock Classes="BodySmall" Text="{Binding SelectedThinkingText}"/>
                            <PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource OutlineVariant}" Margin="4,2"/>

                    <!-- 工作目录 -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="LabelSmall" Text="{x:Static res:Strings.Chat_WorkDir}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}"/>
                        <Button Classes="Outlined" Click="OnWorkDirClick"
                                IsEnabled="{Binding !IsSending}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource IconSourceTree}" Width="14" Height="14"/>
                                <TextBlock Classes="BodySmall"
                                           Text="{Binding WorkDir, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue={x:Static res:Strings.Chat_WorkDirDefault}}"
                                           MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource OutlineVariant}" Margin="4,2"/>

                    <!-- Plan / Build 模式: Build 为高亮(Filled), Plan 为普通(Outlined); 仅显示当前模式文案 -->
                    <ToggleButton x:Name="ModeToggle" Classes="Filled" IsChecked="{Binding IsPlanMode}"
                                  IsEnabled="{Binding !IsSending}"
                                  IsCheckedChanged="OnModeIsCheckedChanged"
                                  ToolTip.Tip="{Binding ModeTip}">
                        <TextBlock Classes="BodySmall" Text="{Binding ModeLabel}"/>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Padding="16,8"
                    BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="InputBox" PlaceholderText="{x:Static res:Strings.Chat_InputPlaceholder}"
                             Text="{Binding InputText}" IsEnabled="{Binding !IsSending}"
                             KeyDown="OnInputKeyDown"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                        <!-- 继续输出: 中断后出现 -->
                        <Button Classes="Outlined" Content="{x:Static res:Strings.Chat_Continue}"
                                Command="{Binding ContinueOutputCommand}" IsVisible="{Binding CanContinue}"
                                ToolTip.Tip="{x:Static res:Strings.Chat_ContinueTip}"/>
                        <!-- 发送中: 显示终止按钮 -->
                        <Button Classes="Filled" Content="{x:Static res:Strings.Chat_Stop}"
                                Command="{Binding StopGenerationCommand}" IsVisible="{Binding IsSending}"
                                Background="{DynamicResource ErrorContainer}"
                                Foreground="{DynamicResource OnErrorContainer}"
                                MinWidth="80" ToolTip.Tip="{x:Static res:Strings.Chat_StopTip}"/>
                        <!-- 空闲: 发送按钮 -->
                        <Button Classes="Filled" Content="{x:Static res:Strings.Chat_Send}"
                                Command="{Binding SendMessageCommand}" IsVisible="{Binding !IsSending}"
                                MinWidth="80"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- 会话列表侧栏已移至最左 -->
        <!-- 右侧工具面板 -->
        <Border Grid.Column="2" Width="300" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1,0,0,0"
                IsVisible="{Binding IsRightPanelVisible}">
            <Panel>
                <ContentControl Content="{Binding AgentPanel}" IsVisible="{Binding IsAssignmentMode}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:AgentPanelViewModel">
                            <v:AgentPanelView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding GitPanel}" IsVisible="{Binding IsGitMode}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:GitPanelViewModel">
                            <v:GitPanelView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding StatusPanel}" IsVisible="{Binding IsStatusMode}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:StatusPanelViewModel">
                            <v:StatusPanelView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Panel>
        </Border>

        <!-- 图标栏(最右侧) -->
        <Border Grid.Column="3" Width="44" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1,0,0,0"
                Background="{DynamicResource SurfaceContainerLow}">
            <Panel>
                <StackPanel Margin="2">
                    <Button Classes="railBtn" Classes.active="{Binding IsAssignmentMode}"
                            Command="{Binding OpenAssignmentPanelCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Panel_AssignToolTip}">
                        <PathIcon Data="{StaticResource IconSmartToySmall}" Width="22" Height="22"/>
                    </Button>
                    <Button Classes="railBtn" Classes.active="{Binding IsGitMode}"
                            Command="{Binding OpenGitPanelCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Panel_GitToolTip}">
                        <PathIcon Data="{StaticResource IconSourceTree}" Width="22" Height="22"/>
                    </Button>
                    <Button Classes="railBtn" Classes.active="{Binding IsStatusMode}"
                            Command="{Binding OpenStatusPanelCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Panel_StatusToolTip}">
                        <PathIcon Data="{StaticResource IconAssessment}" Width="22" Height="22"/>
                    </Button>
                </StackPanel>
                <Button Classes="railBtn" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Command="{Binding ToggleRightPanelCommand}"
                        ToolTip.Tip="{x:Static res:Strings.Panel_ToggleTip}">
                    <Panel>
                        <PathIcon Data="{StaticResource IconCaretRight}" Width="18" Height="18"
                                  IsVisible="{Binding !IsRightPanelVisible}"/>
                        <PathIcon Data="{StaticResource IconCaretLeft}" Width="18" Height="18"
                                  IsVisible="{Binding IsRightPanelVisible}"/>
                    </Panel>
                </Button>
            </Panel>
        </Border>

        </Grid>
    </Grid>

</UserControl>