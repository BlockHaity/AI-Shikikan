<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIShikikan.Gui.ViewModels"
             xmlns:v="using:AIShikikan.Gui.Views"
             xmlns:llm="using:AIShikikan.Core.Services.Llm"
             xmlns:core="using:AIShikikan.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:AIShikikan.Gui.Resources"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AIShikikan.Gui.Views.ChatPageView"
             x:DataType="vm:ChatPageViewModel">

    <UserControl.Resources>
        <v:ThinkingLevelToTextConverter x:Key="ThinkingLevelToTextConverter"/>
        <StreamGeometry x:Key="IconChevronRight">M9.29,6.71a1,1,0,0,0,0,1.41L13.17,12l-3.88,3.88a1,1,0,1,0,1.41,1.41l4.59-4.59a1,1,0,0,0,0-1.41L10.7,6.71A1,1,0,0,0,9.29,6.71Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M7.41,8.59L12,13.17l4.59-4.58L18,10l-6,6l-6-6L7.41,8.59Z</StreamGeometry>
        <StreamGeometry x:Key="IconBulb">M17.66,8.34A6,6 0 0,1 15,18H9A6,6 0 0,1 6.34,8.34C7.5,7.18 8,5.63 8,4A1,1 0 0,1 9,3C10,3 10.53,3.51 11,4C11.47,3.51 12,3 13,3A1,1 0 0,1 14,4C14,5.63 14.5,7.18 15.66,8.34M8,19H16V20A1,1 0 0,1 15,21H9A1,1 0 0,1 8,20V19M14,17H10V18H14V17Z</StreamGeometry>
        <StreamGeometry x:Key="IconCaretRight">M8.59,7.41L10,6l6,6l-6,6l-1.41-1.41L13.17,12L8.59,7.41Z</StreamGeometry>
        <StreamGeometry x:Key="IconCaretLeft">M15.41,7.41L14,6l-6,6l6,6l1.41-1.41L10.83,12L15.41,7.41Z</StreamGeometry>
        <StreamGeometry x:Key="IconSmartToySmall">M22,9v6c0,1.1-0.9,2-2,2h-1v2c0,1.1-0.9,2-2,2H7c-1.1,0-2-0.9-2-2v-2H4c-1.1,0-2-0.9-2-2V9c0-1.1,0.9-2,2-2h1V5c0-1.1,0.9-2,2-2h10c1.1,0,2,0.9,2,2v2h1C21.1,7,22,7.9,22,9zM8,13h6v-2H8V13zM18,11h-2v2h2V11zM19,7h-2v2h2V7zM20,9h-2v2h2V9z</StreamGeometry>
        <StreamGeometry x:Key="IconSourceTree">M22,6c0-1.66,1.34-3,3-3s3,1.34,3,3s-1.34,3-3,3c-0.42,0-0.81-0.09-1.17-0.24l-3.83,5.11c0.52,0.93,0.82,2.01,0.82,3.13h2c1.1,0,2,0.9,2,2s-0.9,2-2,2h-2c-1.1,0-2-0.9-2-2v-8.12l-3.1,0.31c0.06,0.26,0.1,0.53,0.1,0.81v2.83c1.16,0.41,2,1.52,2,2.82c0,1.66-1.34,3-3,3s-3-1.34-3-3c0-1.3,0.84-2.4,2-2.81V19.1c0-0.42,0.04-0.84,0.12-1.24c-1.09-0.22-1.92-1.2-1.92-2.36v-1.87c-1.16-0.41-2-1.52-2-2.81c0-1.66,1.34-3,3-3s3,1.34,3,3c0,1.3-0.84,2.4-2,2.81v1.87c0,0.28,0.22,0.5,0.5,0.5h4.16L18.83,7.83C18.32,7.6,18,6.84,18,6c0-1.66,1.34-3,3-3S22,4.34,22,6z</StreamGeometry>
        <StreamGeometry x:Key="IconAssessment">M19,3H5C3.9,3 3,3.9 3,5v14c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2V5C21,3.9 20.1,3 19,3zM9,17H7v-7h2V17zM13,17h-2V7h2V17zM17,17h-2v-4h2V17z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.railBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style Selector="Button.railBtn.active">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
        </Style>
    </UserControl.Styles>

    <Grid>

        <v:PageBackground ThemeService="{Binding ThemeService}" ScrimOpacity="0.7" />

        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

        <!-- 会话列表侧栏(最左侧) -->
        <Border Grid.Column="0" Width="220" BorderBrush="{DynamicResource OutlineVariant}"
                BorderThickness="0,0,1,0" Background="{DynamicResource SurfaceContainerLow}">
            <ContentControl Content="{Binding SessionPanel}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:SessionPanelViewModel">
                        <v:SessionPanelView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>

        <!-- 聊天区 -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto">

            <Border Grid.Row="0" Padding="16,8" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="TitleSmall" VerticalAlignment="Center"
                               Text="{Binding ActiveModelText}" TextTrimming="CharacterEllipsis"/>
                    <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider}"
                              MinWidth="140" VerticalAlignment="Center"
                              PlaceholderText="{x:Static res:Strings.Chat_SelectProvider}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="llm:ProviderConfig">
                                <TextBlock Text="{Binding Name}" Classes="BodyMedium" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}"
                              MinWidth="180" VerticalAlignment="Center"
                              PlaceholderText="{x:Static res:Strings.Chat_SelectModel}" />
                    <Button Classes="Text" Content="{x:Static res:Strings.Chat_ClearSession}"
                            Command="{Binding ClearMessagesCommand}" IsEnabled="{Binding !IsSending}"/>
                </StackPanel>
            </Border>

            <!-- 消息列表: ListBox(自带受限 ScrollViewer) + VirtualizingStackPanel 真虚拟化(懒加载),
                 仅可见消息实例化重控件; ListBox 是 ItemsControl 子类, 模板内 $parent[ItemsControl] 绑定仍生效 -->
            <ListBox x:Name="MessageList" Grid.Row="1"
                     ItemsSource="{Binding Messages}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="16,8"
                     HorizontalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <!-- 去掉容器默认内边距与选中/悬停高亮, 保持与原 ItemsControl 一致的布局 -->
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <!-- 定向规避(Avalonia 12.0.4 + Material 主题): 消息增删导致容器分离时, 卡内控件的
                         过渡(Opacity/Expander 展开/TextBox 下划线等)订阅会在渲染时钟 Pulse 时悬空触发 NRE。
                         仅清除本列表内这些控件的过渡(不影响全局), 换取编辑/删除/流式增删的稳定。 -->
                    <Style Selector="ListBoxItem Button, ListBoxItem ToggleButton, ListBoxItem Expander, ListBoxItem TextBox">
                        <Setter Property="Transitions">
                            <Transitions/>
                        </Setter>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatItemViewModel">
                            <Panel>
                                <!-- 用户消息: 满宽 + 浅色背景, 右对齐正文; 附带 fork 编辑/删除操作 -->
                                <Border IsVisible="{Binding IsUser}" Margin="0,4"
                                        Padding="16,10" CornerRadius="8"
                                        Background="{DynamicResource SurfaceContainerHigh}"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel>
                                        <!-- 编辑态: 内联编辑器 + 重新发送/取消 -->
                                        <StackPanel IsVisible="{Binding IsEditing}" Spacing="8">
                                            <TextBox Text="{Binding EditText}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MaxHeight="200"/>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Spacing="8">
                                                <Button Classes="Text" Padding="8,2" FontSize="12"
                                                        Content="{x:Static res:Strings.Chat_MsgCancel}"
                                                        Command="{Binding $parent[ItemsControl].((vm:ChatPageViewModel)DataContext).CancelEditUserMessageCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Classes="Filled" Padding="8,2" FontSize="12"
                                                        Content="{x:Static res:Strings.Chat_MsgResend}"
                                                        Command="{Binding $parent[ItemsControl].((vm:ChatPageViewModel)DataContext).ConfirmEditUserMessageCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- 正常态: 正文 + 编辑/删除(删除为两段式确认) -->
                                        <DockPanel IsVisible="{Binding !IsEditing}">
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal" Spacing="2"
                                                        VerticalAlignment="Top"
                                                        Margin="8,0,0,0">
                                                <Button Classes="Text" Padding="4,0" FontSize="11"
                                                        Content="{x:Static res:Strings.Chat_MsgEdit}"
                                                        Command="{Binding $parent[ItemsControl].((vm:ChatPageViewModel)DataContext).StartEditUserMessageCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Classes="Text" Padding="4,0" FontSize="11"
                                                        Content="{Binding DeleteText}"
                                                        Command="{Binding $parent[ItemsControl].((vm:ChatPageViewModel)DataContext).DeleteUserMessageCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <SelectableTextBlock Classes="BodyMedium"
                                                                 Text="{Binding UserBody}"
                                                                 TextWrapping="Wrap"
                                                                 HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- AI 消息: 无气泡, 分段堆叠 (思考/工具卡片 + 正文 markdown); VisibleSegments 访问即物化 -->
                                <StackPanel IsVisible="{Binding !IsUser}" Spacing="6" Margin="0,4">
                                    <ItemsControl ItemsSource="{Binding VisibleSegments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SegmentItemViewModel">
                                                <Panel>
                                                    <!-- 正文 Markdown -->
                                                    <md:MarkdownScrollViewer IsVisible="{Binding IsText}"
                                                                             Markdown="{Binding BodyContent}"
                                                                             Padding="0">
                                                        <md:MarkdownScrollViewer.Styles>
                                                            <StyleInclude Source="avares://AIShikikan.Gui/Resources/MarkdownTheme.axaml"/>
                                                        </md:MarkdownScrollViewer.Styles>
                                                    </md:MarkdownScrollViewer>

                                                    <!-- 思考过程折叠卡片 -->
                                                    <Expander IsVisible="{Binding IsThinking}"
                                                              IsExpanded="{Binding IsExpanded}"
                                                              Margin="0,2">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Classes="BodySmall" Text="{Binding CardGlyph}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Classes="LabelLarge" Text="{Binding CardTitle}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <Border Padding="8" Background="{DynamicResource SurfaceContainerLow}"
                                                                CornerRadius="4">
                                                            <SelectableTextBlock Classes="BodySmall"
                                                                                 Text="{Binding ThinkingContent}"
                                                                                 TextWrapping="Wrap"/>
                                                        </Border>
                                                    </Expander>

                                                    <!-- 工具调用折叠卡片: 统一卡头(状态指示/标题/操作按钮区) + 按工具类型的专属卡体 -->
                                                    <Expander IsVisible="{Binding IsTool}"
                                                              IsExpanded="{Binding IsExpanded}"
                                                              Margin="0,2">
                                                        <Expander.Header>
                                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <!-- 执行状态指示器 -->
                                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                             Fill="{DynamicResource OnSurfaceVariant}"
                                                                             IsVisible="{Binding IsStatusRunning}"/>
                                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                             Fill="{DynamicResource Primary}"
                                                                             IsVisible="{Binding IsStatusSuccess}"/>
                                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                             Fill="{DynamicResource Error}"
                                                                             IsVisible="{Binding IsStatusError}"/>
                                                                    <TextBlock Classes="LabelLarge" Text="{Binding CardTitle}"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Classes="LabelSmall" Text="{Binding StatusText}"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                </StackPanel>
                                                                <!-- 操作按钮区域 -->
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                                                    <Button Classes="Text" Padding="8,2" FontSize="11"
                                                                            Content="{Binding CopyButtonText}"
                                                                            Command="{Binding CopyResultCommand}"/>
                                                                    <Button Classes="Outlined" Padding="8,2" FontSize="11"
                                                                            Content="{Binding RollbackText}"
                                                                            Command="{Binding RollbackCommand}"
                                                                            IsVisible="{Binding CanRollback}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Expander.Header>
                                                        <Border Padding="8" Background="{DynamicResource SurfaceContainerLow}"
                                                                CornerRadius="4">
                                                            <StackPanel Spacing="6">
                                                                <!-- read_file: 完整路径 + 原始内容(保留格式与缩进) -->
                                                                <StackPanel IsVisible="{Binding HasFileRead}" Spacing="6">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                        <SelectableTextBlock Classes="BodySmall"
                                                                                             Text="{Binding FileRead.Path}"
                                                                                             TextWrapping="Wrap"/>
                                                                        <TextBlock Grid.Column="1" Classes="LabelSmall"
                                                                                   Text="{Binding FileReadMeta}"
                                                                                   Foreground="{DynamicResource OnSurfaceVariant}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <Border CornerRadius="4" MaxHeight="320"
                                                                            Background="{DynamicResource SurfaceContainerHigh}">
                                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                                      VerticalScrollBarVisibility="Auto">
                                                                            <SelectableTextBlock Margin="8,6"
                                                                                                 FontFamily="{DynamicResource MonoThemeFontFamily}"
                                                                                                 FontSize="12"
                                                                                                 Text="{Binding FileRead.Content}"
                                                                                                 TextWrapping="NoWrap"/>
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                    <TextBlock Classes="LabelSmall"
                                                                               Text="{x:Static res:Strings.ToolCard_FileTruncated}"
                                                                               IsVisible="{Binding FileRead.Truncated}"
                                                                               Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                </StackPanel>

                                                                <!-- list_directory: 结构化列表(名称/类型/大小/修改时间) -->
                                                                <StackPanel IsVisible="{Binding HasDirectoryList}" Spacing="6">
                                                                    <TextBlock Classes="BodySmall" Text="{Binding DirectoryList.Path}"/>
                                                                    <Border CornerRadius="4" MaxHeight="320"
                                                                            Background="{DynamicResource SurfaceContainerHigh}">
                                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                            <ItemsControl Margin="8,6" ItemsSource="{Binding DirectoryList.Entries}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="core:DirectoryEntry">
                                                                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                                                              ColumnSpacing="12" Margin="0,1">
                                                                                            <TextBlock Classes="BodySmall"
                                                                                                       Text="{Binding DisplayName}"
                                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                                            <Panel Grid.Column="1">
                                                                                                <TextBlock Classes="LabelSmall"
                                                                                                           Text="{x:Static res:Strings.ToolCard_TypeDir}"
                                                                                                           Foreground="{DynamicResource Primary}"
                                                                                                           IsVisible="{Binding IsDirectory}"/>
                                                                                                <TextBlock Classes="LabelSmall"
                                                                                                           Text="{x:Static res:Strings.ToolCard_TypeFile}"
                                                                                                           Foreground="{DynamicResource OnSurfaceVariant}"
                                                                                                           IsVisible="{Binding !IsDirectory}"/>
                                                                                            </Panel>
                                                                                            <TextBlock Grid.Column="2" Classes="LabelSmall"
                                                                                                       Text="{Binding SizeText}"
                                                                                                       Foreground="{DynamicResource OnSurfaceVariant}"
                                                                                                       IsVisible="{Binding !IsDirectory}"/>
                                                                                            <TextBlock Grid.Column="3" Classes="LabelSmall"
                                                                                                       Text="{Binding ModifiedText}"
                                                                                                       Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                    <TextBlock Classes="LabelSmall"
                                                                               Text="{x:Static res:Strings.ToolCard_Truncated}"
                                                                               IsVisible="{Binding DirectoryList.Truncated}"
                                                                               Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                </StackPanel>

                                                                <!-- glob: 查询条件 + 匹配文件路径 -->
                                                                <StackPanel IsVisible="{Binding HasGlob}" Spacing="6">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                        <TextBlock Classes="BodySmall" Text="{Binding GlobQueryText}"/>
                                                                        <TextBlock Grid.Column="1" Classes="LabelSmall"
                                                                                   Text="{Binding GlobCountText}"
                                                                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                    </Grid>
                                                                    <Border CornerRadius="4" MaxHeight="320"
                                                                            Background="{DynamicResource SurfaceContainerHigh}">
                                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                            <ItemsControl Margin="8,6" ItemsSource="{Binding Glob.Matches}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="core:FileMatchEntry">
                                                                                        <SelectableTextBlock Classes="BodySmall"
                                                                                                             FontFamily="{DynamicResource MonoThemeFontFamily}"
                                                                                                             Text="{Binding Path}"
                                                                                                             Margin="0,1"/>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                    <TextBlock Classes="LabelSmall"
                                                                               Text="{x:Static res:Strings.ToolCard_Truncated}"
                                                                               IsVisible="{Binding Glob.Truncated}"
                                                                               Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                </StackPanel>

                                                                <!-- grep: 查询条件 + 路径/行号/匹配行上下文 -->
                                                                <StackPanel IsVisible="{Binding HasGrep}" Spacing="6">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                        <TextBlock Classes="BodySmall" Text="{Binding GrepQueryText}"/>
                                                                        <TextBlock Grid.Column="1" Classes="LabelSmall"
                                                                                   Text="{Binding GrepCountText}"
                                                                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                    </Grid>
                                                                    <Border CornerRadius="4" MaxHeight="320"
                                                                            Background="{DynamicResource SurfaceContainerHigh}">
                                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                            <ItemsControl Margin="8,6" ItemsSource="{Binding Grep.Matches}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="core:GrepMatchEntry">
                                                                                        <StackPanel Margin="0,2">
                                                                                            <SelectableTextBlock Classes="LabelSmall"
                                                                                                                 FontFamily="{DynamicResource MonoThemeFontFamily}"
                                                                                                                 Foreground="{DynamicResource Primary}">
                                                                                                <Run Text="{Binding Path}"/><Run Text=":"/><Run Text="{Binding Line}"/>
                                                                                            </SelectableTextBlock>
                                                                                            <SelectableTextBlock FontFamily="{DynamicResource MonoThemeFontFamily}"
                                                                                                                 FontSize="12"
                                                                                                                 Text="{Binding Text}"
                                                                                                                 TextWrapping="Wrap"/>
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                    <TextBlock Classes="LabelSmall"
                                                                               Text="{x:Static res:Strings.ToolCard_Truncated}"
                                                                               IsVisible="{Binding Grep.Truncated}"
                                                                               Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                </StackPanel>

                                                                <!-- run_subagents / run_<agent>: 每个子 agent 独立固定尺寸框 -->
                                                                <StackPanel IsVisible="{Binding HasSubagents}" Spacing="6">
                                                                    <ItemsControl ItemsSource="{Binding Subagents.Subagents}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="core:SubagentResultEntry">
                                                                                <Border Width="320" Height="220" CornerRadius="8"
                                                                                        Margin="0,0,8,8" BorderThickness="1"
                                                                                        BorderBrush="{DynamicResource OutlineVariant}"
                                                                                        Background="{DynamicResource SurfaceContainerLow}">
                                                                                    <DockPanel Margin="10">
                                                                                        <Grid DockPanel.Dock="Top"
                                                                                              ColumnDefinitions="Auto,*,Auto"
                                                                                              ColumnSpacing="6">
                                                                                            <Panel VerticalAlignment="Center">
                                                                                                <Ellipse Width="8" Height="8"
                                                                                                         Fill="{DynamicResource Primary}"
                                                                                                         IsVisible="{Binding IsSuccess}"/>
                                                                                                <Ellipse Width="8" Height="8"
                                                                                                         Fill="{DynamicResource Error}"
                                                                                                         IsVisible="{Binding !IsSuccess}"/>
                                                                                            </Panel>
                                                                                            <TextBlock Grid.Column="1" Classes="BodySmall"
                                                                                                       Text="{Binding AgentName}"
                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                       VerticalAlignment="Center"/>
                                                                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                                                                <TextBlock Classes="LabelSmall"
                                                                                                           Text="{x:Static res:Strings.ToolCard_SubagentDone}"
                                                                                                           Foreground="{DynamicResource Primary}"
                                                                                                           IsVisible="{Binding IsSuccess}"/>
                                                                                                <TextBlock Classes="LabelSmall"
                                                                                                           Text="{x:Static res:Strings.ToolCard_SubagentFailed}"
                                                                                                           Foreground="{DynamicResource Error}"
                                                                                                           IsVisible="{Binding IsError}"/>
                                                                                                <TextBlock Classes="LabelSmall"
                                                                                                           Text="{x:Static res:Strings.ToolCard_SubagentTimeout}"
                                                                                                           Foreground="{DynamicResource Error}"
                                                                                                           IsVisible="{Binding TimedOut}"/>
                                                                                            </Panel>
                                                                                        </Grid>
                                                                                        <TextBlock DockPanel.Dock="Top" Classes="LabelSmall"
                                                                                                   Text="{Binding MetaText}"
                                                                                                   Foreground="{DynamicResource OnSurfaceVariant}"
                                                                                                   Margin="14,2,0,6"/>
                                                                                        <Border CornerRadius="4"
                                                                                                Background="{DynamicResource SurfaceContainerHigh}">
                                                                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                                                <SelectableTextBlock Margin="8,6"
                                                                                                                     FontFamily="{DynamicResource MonoThemeFontFamily}"
                                                                                                                     FontSize="11"
                                                                                                                     Text="{Binding Output}"
                                                                                                                     TextWrapping="Wrap"/>
                                                                                            </ScrollViewer>
                                                                                        </Border>
                                                                                    </DockPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                                <!-- 通用回退卡体: 无结构化数据的工具(参数 / 流式输出 / 结果) -->
                                                                <StackPanel IsVisible="{Binding HasNoDetail}" Spacing="6">
                                                                    <DockPanel>
                                                                        <TextBlock Classes="LabelSmall" Text="{x:Static res:Strings.ToolCard_Parameters}"
                                                                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                        <Button DockPanel.Dock="Right" Classes="Text"
                                                                                Content="{Binding ArgumentsToggleText}"
                                                                                Command="{Binding ToggleArgumentsViewCommand}"
                                                                                FontSize="11"/>
                                                                    </DockPanel>
                                                                    <md:MarkdownScrollViewer Markdown="{Binding ArgumentsDisplay}">
                                                                        <md:MarkdownScrollViewer.Styles>
                                                                            <StyleInclude Source="avares://AIShikikan.Gui/Resources/MarkdownTheme.axaml"/>
                                                                        </md:MarkdownScrollViewer.Styles>
                                                                    </md:MarkdownScrollViewer>

                                                                    <StackPanel IsVisible="{Binding HasToolOutput}">
                                                                        <TextBlock Classes="LabelSmall" Text="{x:Static res:Strings.ToolCard_Output}"
                                                                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                        <SelectableTextBlock Classes="BodySmall"
                                                                                             Text="{Binding ToolOutput}"
                                                                                             TextWrapping="Wrap"/>
                                                                    </StackPanel>

                                                                    <StackPanel IsVisible="{Binding HasToolResult}">
                                                                        <TextBlock Classes="LabelSmall" Text="{x:Static res:Strings.ToolCard_Result}"
                                                                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                                                                        <md:MarkdownScrollViewer Markdown="{Binding ToolResult}">
                                                                            <md:MarkdownScrollViewer.Styles>
                                                                                <StyleInclude Source="avares://AIShikikan.Gui/Resources/MarkdownTheme.axaml"/>
                                                                            </md:MarkdownScrollViewer.Styles>
                                                                        </md:MarkdownScrollViewer>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- 回滚结果提示(所有卡体共用) -->
                                                                <TextBlock Classes="BodySmall" Text="{Binding RollbackNote}"
                                                                           IsVisible="{Binding HasRollbackNote}"
                                                                           Foreground="{DynamicResource Primary}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Expander>
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Panel>
                        </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 工具栏: 思考深度 / 工作目录 / Plan-Build 模式 -->
            <Border Grid.Row="2" Padding="12,4" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource SurfaceContainerLow}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <!-- 思考档位: 单按钮 + 展开菜单 -->
                    <Button x:Name="ThinkingButton" Classes="Outlined" IsEnabled="{Binding !IsSending}" MinWidth="92"
                            ToolTip.Tip="{x:Static res:Strings.Chat_Thinking}">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ListBox x:Name="ThinkingList" ItemsSource="{Binding ThinkingOptions}"
                                         SelectedItem="{Binding SelectedThinking, Mode=TwoWay}"
                                         SelectionChanged="OnThinkingSelected"
                                         MinWidth="150" MaxHeight="240">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="llm:ThinkingLevel">
                                            <TextBlock Classes="BodyMedium"
                                                       Text="{Binding, Converter={StaticResource ThinkingLevelToTextConverter}}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconBulb}" Width="14" Height="14"/>
                            <TextBlock Classes="BodySmall" Text="{Binding SelectedThinkingText}"/>
                            <PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource OutlineVariant}" Margin="4,2"/>

                    <!-- 工作目录 -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="LabelSmall" Text="{x:Static res:Strings.Chat_WorkDir}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}"/>
                        <Button Classes="Outlined" Click="OnWorkDirClick"
                                IsEnabled="{Binding !IsSending}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource IconSourceTree}" Width="14" Height="14"/>
                                <TextBlock Classes="BodySmall"
                                           Text="{Binding WorkDir, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue={x:Static res:Strings.Chat_WorkDirDefault}}"
                                           MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource OutlineVariant}" Margin="4,2"/>

                    <!-- Plan / Build 模式: Build 为高亮(Filled), Plan 为普通(Outlined); 仅显示当前模式文案 -->
                    <ToggleButton x:Name="ModeToggle" Classes="Filled" IsChecked="{Binding IsPlanMode}"
                                  IsEnabled="{Binding !IsSending}"
                                  IsCheckedChanged="OnModeIsCheckedChanged"
                                  ToolTip.Tip="{Binding ModeTip}">
                        <TextBlock Classes="BodySmall" Text="{Binding ModeLabel}"/>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Padding="16,8"
                    BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="InputBox" PlaceholderText="{x:Static res:Strings.Chat_InputPlaceholder}"
                             Text="{Binding InputText}" IsEnabled="{Binding !IsSending}"
                             KeyDown="OnInputKeyDown"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                        <!-- 继续输出: 中断后出现 -->
                        <Button Classes="Outlined" Content="{x:Static res:Strings.Chat_Continue}"
                                Command="{Binding ContinueOutputCommand}" IsVisible="{Binding CanContinue}"
                                ToolTip.Tip="{x:Static res:Strings.Chat_ContinueTip}"/>
                        <!-- 发送中: 显示终止按钮 -->
                        <Button Classes="Filled" Content="{x:Static res:Strings.Chat_Stop}"
                                Command="{Binding StopGenerationCommand}" IsVisible="{Binding IsSending}"
                                Background="{DynamicResource ErrorContainer}"
                                Foreground="{DynamicResource OnErrorContainer}"
                                MinWidth="80" ToolTip.Tip="{x:Static res:Strings.Chat_StopTip}"/>
                        <!-- 空闲: 发送按钮 -->
                        <Button Classes="Filled" Content="{x:Static res:Strings.Chat_Send}"
                                Command="{Binding SendMessageCommand}" IsVisible="{Binding !IsSending}"
                                MinWidth="80"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- 会话列表侧栏已移至最左 -->
        <!-- 右侧工具面板 -->
        <Border Grid.Column="2" Width="300" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1,0,0,0"
                IsVisible="{Binding IsRightPanelVisible}">
            <Panel>
                <ContentControl Content="{Binding AgentPanel}" IsVisible="{Binding IsAssignmentMode}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:AgentPanelViewModel">
                            <v:AgentPanelView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding GitPanel}" IsVisible="{Binding IsGitMode}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:GitPanelViewModel">
                            <v:GitPanelView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
                <ContentControl Content="{Binding StatusPanel}" IsVisible="{Binding IsStatusMode}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:StatusPanelViewModel">
                            <v:StatusPanelView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Panel>
        </Border>

        <!-- 图标栏(最右侧) -->
        <Border Grid.Column="3" Width="44" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1,0,0,0"
                Background="{DynamicResource SurfaceContainerLow}">
            <Panel>
                <StackPanel Margin="2">
                    <Button Classes="railBtn" Classes.active="{Binding IsAssignmentMode}"
                            Command="{Binding OpenAssignmentPanelCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Panel_AssignToolTip}">
                        <PathIcon Data="{StaticResource IconSmartToySmall}" Width="22" Height="22"/>
                    </Button>
                    <Button Classes="railBtn" Classes.active="{Binding IsGitMode}"
                            Command="{Binding OpenGitPanelCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Panel_GitToolTip}">
                        <PathIcon Data="{StaticResource IconSourceTree}" Width="22" Height="22"/>
                    </Button>
                    <Button Classes="railBtn" Classes.active="{Binding IsStatusMode}"
                            Command="{Binding OpenStatusPanelCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Panel_StatusToolTip}">
                        <PathIcon Data="{StaticResource IconAssessment}" Width="22" Height="22"/>
                    </Button>
                </StackPanel>
                <Button Classes="railBtn" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Command="{Binding ToggleRightPanelCommand}"
                        ToolTip.Tip="{x:Static res:Strings.Panel_ToggleTip}">
                    <Panel>
                        <PathIcon Data="{StaticResource IconCaretRight}" Width="18" Height="18"
                                  IsVisible="{Binding !IsRightPanelVisible}"/>
                        <PathIcon Data="{StaticResource IconCaretLeft}" Width="18" Height="18"
                                  IsVisible="{Binding IsRightPanelVisible}"/>
                    </Panel>
                </Button>
            </Panel>
        </Border>

        </Grid>
    </Grid>

</UserControl>