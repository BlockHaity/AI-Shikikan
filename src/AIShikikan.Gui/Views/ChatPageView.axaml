<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIShikikan.Gui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             xmlns:res="clr-namespace:AIShikikan.Gui.Resources"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AIShikikan.Gui.Views.ChatPageView"
             x:DataType="vm:ChatPageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.secTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.secDesc">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
        </Style>
        <Style Selector="Border.agentEntry">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,280" IsVisible="{Binding IsRightPanelVisible}">

        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

            <Border Grid.Row="0" Padding="16,8" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="TitleSmall" VerticalAlignment="Center"
                               Text="{Binding ActiveModelText}" TextTrimming="CharacterEllipsis"/>
                    <Button Classes="Text" Content="{x:Static res:Strings.Chat_ClearSession}"
                            Command="{Binding ClearMessagesCommand}" IsEnabled="{Binding !IsSending}"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="MessageScroller" Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Messages}" Margin="16,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" Padding="12,8"
                                    CornerRadius="8"
                                    Background="{Binding Role, Converter={StaticResource MessageBgConverter}}"
                                    HorizontalAlignment="{Binding Role, Converter={StaticResource MessageAlignConverter}}"
                                    MaxWidth="520">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="LabelSmall"
                                               Text="{Binding RoleLabel}"
                                               Foreground="{DynamicResource OnSurfaceVariant}" />
                                    <TextBlock Classes="BodyMedium" Text="{Binding Content}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16,8"
                    BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="InputBox" PlaceholderText="{x:Static res:Strings.Chat_InputPlaceholder}"
                             Text="{Binding InputText}" IsEnabled="{Binding !IsSending}"
                             KeyDown="OnInputKeyDown" />
                    <Button Grid.Column="1" Classes="Filled" Margin="8,0,0,0"
                            Content="{x:Static res:Strings.Chat_Send}"
                            Command="{Binding SendMessageCommand}" IsEnabled="{Binding !IsSending}" />
                </Grid>
            </Border>

        </Grid>

        <Border x:Name="RightPanel" Grid.Column="1" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1,0,0,0"
                IsVisible="{Binding IsRightPanelVisible}">
            <ScrollViewer>
                <StackPanel Margin="12" Spacing="14">

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="{x:Static res:Strings.Chat_PanelTitle}" Classes="TitleMedium" />
                        <Button Classes="Icon" Command="{Binding ToggleRightPanelCommand}"
                                ToolTip.Tip="{x:Static res:Strings.Chat_TogglePanel}">
                            <PathIcon Data="{StaticResource IconCaretLeft}" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static res:Strings.Chat_Expert}" Classes="secTitle" />
                        <TextBlock Text="{x:Static res:Strings.Chat_ExpertDesc}" Classes="secDesc" TextWrapping="Wrap" />
                        <ListBox ItemsSource="{Binding Personas}" SelectedItem="{Binding SelectedPersona}"
                                 MaxHeight="150">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Display}" Classes="BodyMedium"/>
                                        <TextBlock Text="{Binding Kind}" Classes="LabelSmall"
                                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ToggleSwitch IsChecked="{Binding UseCommanderPersonaForAgents}"
                                      Content="{x:Static res:Strings.Chat_CommanderPersona}"
                                      Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Static res:Strings.Chat_Assign}" Classes="secTitle" />
                            <ToggleSwitch IsChecked="{Binding RosterEnabled}"
                                          ToolTip.Tip="{x:Static res:Strings.Chat_ToggleRoster}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.Chat_AssignDesc}" Classes="secDesc" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding RosterEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="agentEntry"
                                            IsVisible="{Binding $parent[UserControl].((vm:ChatPageViewModel)DataContext).RosterEnabled}">
                                        <StackPanel>
                                            <!-- 头部 -->
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Classes="Icon" Width="20" Height="20"
                                                            Command="{Binding $parent[UserControl].((vm:ChatPageViewModel)DataContext).ToggleEntryExpandedCommand}"
                                                            CommandParameter="{Binding}"
                                                            Padding="0">
                                                        <PathIcon Data="{Binding IsExpanded, Converter={StaticResource CollapsedToIconConverter}}"
                                                                  Width="14" Height="14" />
                                                    </Button>
                                                    <TextBlock Text="{Binding DisplayText}" Classes="BodyMedium"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ToggleSwitch IsChecked="{Binding Enabled}"
                                                              Command="{Binding $parent[UserControl].((vm:ChatPageViewModel)DataContext).ToggleEntryEnabledCommand}"
                                                              CommandParameter="{Binding}"
                                                              VerticalAlignment="Center"/>
                                                <Button Classes="Text" Content="✕"
                                                        Command="{Binding $parent[UserControl].((vm:ChatPageViewModel)DataContext).DeleteEntryCommand}"
                                                        CommandParameter="{Binding}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- 展开内容 -->
                                            <StackPanel IsVisible="{Binding IsExpanded}" Margin="8,0,8,8" Spacing="8">
                                                <TextBox Text="{Binding Description}" Watermark="{x:Static res:Strings.Chat_EntryDesc}"
                                                         AcceptsReturn="True" MinHeight="50" TextWrapping="Wrap"
                                                         FontSize="12"/>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{x:Static res:Strings.Chat_BindPersona}" Classes="secTitle"/>
                                                     <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:ChatPageViewModel)DataContext).Personas}"
                                                               SelectedItem="{Binding Persona, Mode=TwoWay}"
                                                               HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Display}" Classes="BodyMedium"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                     <TextBlock IsVisible="{Binding Persona is not null}"
                                                                Classes="BodySmall"
                                                                Foreground="{DynamicResource OnSurfaceVariant}"
                                                                Text="{Binding Persona.Display}"/>
                                                </StackPanel>
                                                <Button Classes="Text" Content="{x:Static res:Strings.Chat_SaveEntry}"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding $parent[UserControl].((vm:ChatPageViewModel)DataContext).SaveEntryCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 快速分配区 -->
                        <StackPanel Spacing="4" Margin="0,8,0,0">
                            <TextBlock Text="{x:Static res:Strings.Chat_QuickAssign}" Classes="secTitle"/>
                            <ComboBox ItemsSource="{Binding Agents}"
                                      SelectedItem="{Binding SelectedAgent}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" Classes="BodyMedium"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Text="{Binding AssignTaskText}" Watermark="{x:Static res:Strings.Chat_AssignTaskWatermark}"
                                     AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <ToggleSwitch Content="{x:Static res:Strings.Chat_AsyncMode}" IsChecked="{Binding IsAsyncAssign}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="Filled"
                                        Content="{x:Static res:Strings.Chat_StartAssign}"
                                        Command="{Binding AssignCommand}" IsEnabled="{Binding !IsAssigning}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static res:Strings.Chat_Assignments}" Classes="secTitle" />
                        <ListBox ItemsSource="{Binding Assignments}" MaxHeight="160">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding AssignmentId}" Classes="LabelSmall"
                                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                                        <TextBlock Text="{Binding Display}" Classes="BodySmall" TextTrimming="CharacterEllipsis"/>
                                        <Button Classes="Text" Content="✕" ToolTip.Tip="{x:Static res:Strings.Chat_Cancel}"
                                                Command="{Binding $parent[UserControl].((vm:ChatPageViewModel)DataContext).CancelAssignmentCommand}"
                                                CommandParameter="{Binding AssignmentId}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static res:Strings.Chat_Git}" Classes="secTitle" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="FilledTonal" Content="{x:Static res:Strings.Chat_Refresh}"
                                    Command="{Binding RefreshGitCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GitStateText}" Classes="BodySmall" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding GitSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="8,6" CornerRadius="6"
                                            BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="BodySmall"
                                                       Text="{Binding StepId}" Foreground="{DynamicResource Primary}"/>
                                            <TextBlock Classes="BodySmall" Text="{Binding Label}" TextWrapping="Wrap"/>
                                            <TextBlock Classes="LabelSmall"
                                                       Foreground="{DynamicResource OnSurfaceVariant}"
                                                       Text="{Binding StepBranch} → {Binding BaseBranch}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Classes="Text" Content="{x:Static res:Strings.Chat_GitMerge}"
                                                        Command="{Binding $parent[UserControl].((vm:ChatPageViewModel)DataContext).MergeStepCommand}"
                                                        CommandParameter="{Binding StepId}"/>
                                                <Button Classes="Text" Content="{x:Static res:Strings.Chat_GitDrop}"
                                                        Command="{Binding $parent[UserControl].((vm:ChatPageViewModel)DataContext).DropStepCommand}"
                                                        CommandParameter="{Binding StepId}"/>
                                                <Button Classes="Text" Content="{x:Static res:Strings.Chat_GitRevert}"
                                                        Command="{Binding $parent[UserControl].((vm:ChatPageViewModel)DataContext).RevertStepCommand}"
                                                        CommandParameter="{Binding StepId}"/>
                                                <Button Classes="Text" Content="{x:Static res:Strings.Chat_GitDiff}"
                                                        Command="{Binding $parent[UserControl].((vm:ChatPageViewModel)DataContext).ShowGitDiffCommand}"
                                                        CommandParameter="{Binding StepId}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox Text="{Binding GitDiffText}" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="monospace" FontSize="12" MinHeight="80" MaxHeight="220"
                                 IsVisible="{Binding HasGitDiff}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>

</UserControl>
