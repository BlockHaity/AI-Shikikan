<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIShikikan.Gui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:AIShikikan.Gui.Resources"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="AIShikikan.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        Title="{Binding Title}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <!-- 收缩栏导航项(圆形选中指示器): 覆盖库内 M3NavigationRailItem, 指示器由 56x32 胶囊改为 40x40 正圆 -->
        <ControlTheme x:Key="M3NavigationRailItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="MinHeight" Value="{DynamicResource NavItemHeight}" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 40x40 圆形选中指示器(仅图标区域, 常驻尺寸, 选中仅切换 Opacity) -->
                        <Panel Width="40" Height="40" HorizontalAlignment="Center">
                            <Border x:Name="SelectedLayer" CornerRadius="20"
                                    Background="{DynamicResource SecondaryContainer}" Opacity="0" />
                            <Border x:Name="StateLayer" CornerRadius="20"
                                    Background="{DynamicResource OnSurface}" Opacity="0">
                                <Border.Transitions>
                                    <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationShort2}" /></Transitions>
                                </Border.Transitions>
                            </Border>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{DynamicResource OnSurfaceVariant}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                        <TextBlock x:Name="RailLabel" Text="{TemplateBinding Tag}"
                                   IsVisible="{TemplateBinding Tag, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Foreground="{DynamicResource OnSurfaceVariant}"
                                   FontSize="{DynamicResource FontSizeLabelMedium}" FontWeight="Medium" LineHeight="16"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                   Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:selected /template/ Border#SelectedLayer">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSecondaryContainer}" />
            </Style>
            <Style Selector="^:selected /template/ TextBlock#RailLabel">
                <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
            </Style>
            <Style Selector="^:selected /template/ Border#StateLayer">
                <Setter Property="Background" Value="{DynamicResource OnSecondaryContainer}" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#StateLayer">
                <Setter Property="Opacity" Value="0.08" />
            </Style>
            <Style Selector="^:pressed /template/ Border#StateLayer">
                <Setter Property="Opacity" Value="0.10" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
            </Style>
            <Style Selector="^:disabled /template/ TextBlock#RailLabel">
                <Setter Property="Foreground" Value="{DynamicResource OnSurface38}" />
            </Style>
            <Style Selector="^:selected:disabled /template/ Border#SelectedLayer">
                <Setter Property="Background" Value="{DynamicResource OnSurface12}" />
            </Style>
        </ControlTheme>

        <StreamGeometry x:Key="IconHome">M160-120v-375l-57 43-47-63 424-321 424 321-47 64-57-44v375H540v-240H420v240H160Zm80-80h100v-240h240v240h100v-387L480-754 240-587v387Zm240-290Z</StreamGeometry>
        <StreamGeometry x:Key="IconSmartToy">M160-160v-40h-40q-33 0-56.5-23.5T40-280v-400q0-33 23.5-56.5T120-760h40v-40q0-33 23.5-56.5T260-880h440q33 0 56.5 23.5T780-800v40h40q33 0 56.5 23.5T900-680v400q0 33-23.5 56.5T820-180h-40v40q0 33-23.5 56.5T700-60H260q-33 0-56.5-23.5T180-140Zm-40-120h680v-400H120v400Zm140-40h360q17 0 28.5-11.5T660-360q0-17-11.5-28.5T620-400H260q-17 0-28.5 11.5T220-360q0 17 11.5 28.5T260-320Z</StreamGeometry>
        <StreamGeometry x:Key="IconSun">M480-360q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35Zm0 80q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Zm326-268Z</StreamGeometry>
        <StreamGeometry x:Key="IconMoon">M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Zm0-80q88 0 158-48.5T740-375q-20 5-40 8t-40 3q-123 0-209.5-86.5T364-660q0-20 3-40t8-40q-78 32-126.5 102T200-480q0 116 82 198t198 82Zm-10-270Z</StreamGeometry>
        <StreamGeometry x:Key="IconChat">M80-80v-720q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H240L80-80Zm160-240h560v-480H160v480l80-80Zm-80 0v-480 480Z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">m370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm70-80h79l14-106q31-8 57.5-23.5T639-327l99 41 39-68-86-65q5-14 7-29.5t2-31.5q0-16-2-31.5t-7-29.5l86-65-39-68-99 42q-22-23-48.5-38.5T533-694l-13-106h-79l-14 106q-31 8-57.5 23.5T321-633l-99-41-39 68 86 64q-5 15-7 30t-2 32q0 16 2 31t7 30l-86 65 39 68 99-42q22 23 48.5 38.5T427-266l13 106Zm42-180q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Zm-2-140Z</StreamGeometry>
        <StreamGeometry x:Key="IconCaretLeft">M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- 收缩栏导航项: 与 Icon 按钮一致的居中布局与配色 -->
        <Style Selector="ListBox.NavigationRail ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style Selector="ListBox.NavigationRail ListBoxItem PathIcon">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style Selector="ListBox.NavigationRail ListBoxItem TextBlock.RailLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MaxWidth" Value="64"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Background="{DynamicResource Surface}" />

        <DrawerPage x:Name="Shell" DrawerBehavior="Locked" IsOpen="True" DrawerLength="220">

            <DrawerPage.DrawerHeader>
                <!-- 与导航项同规格: 相同 Margin/行高, 图标 24px, 文字 LabelLarge -->
                <StackPanel x:Name="ShellHeader" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"
                            Height="{DynamicResource NavItemHeight}" Margin="16,0,24,0">
                    <Image Source="avares://AIShikikan.Gui/Assets/logo.jpg" Width="24" Height="24"
                           Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Classes="LabelLarge" Text="{x:Static res:Strings.App_Title}" VerticalAlignment="Center"
                               IsVisible="{Binding !IsRail}" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                </StackPanel>
            </DrawerPage.DrawerHeader>

            <DrawerPage.Drawer>
                <Panel>
                    <ListBox x:Name="NavList" Classes="NavigationDrawer" SelectedIndex="0"
                             IsVisible="{Binding !IsRail}"
                             SelectionChanged="OnNavSelectionChanged">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconHome}" Width="24" Height="24" />
                                <TextBlock Classes="LabelLarge" Text="{x:Static res:Strings.Nav_Home}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="100" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconChat}" Width="24" Height="24" />
                                <TextBlock Classes="LabelLarge" Text="{x:Static res:Strings.Nav_Chat}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="100" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconSettings}" Width="24" Height="24" />
                                <TextBlock Classes="LabelLarge" Text="{x:Static res:Strings.Nav_Settings}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="100" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                    <ListBox x:Name="RailList" Classes="NavigationRail" VerticalAlignment="Top"
                             IsVisible="{Binding IsRail}"
                             SelectedIndex="{Binding #NavList.SelectedIndex, Mode=TwoWay}"
                             SelectionChanged="OnNavSelectionChanged">
                        <ListBoxItem Classes="M3NavigationRailItem" ToolTip.Tip="{x:Static res:Strings.Nav_Home}">
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <PathIcon Data="{StaticResource IconHome}" Width="24" Height="24" HorizontalAlignment="Center" />
                                <TextBlock Classes="RailLabel LabelSmall" Text="{x:Static res:Strings.Nav_Home}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Classes="M3NavigationRailItem" ToolTip.Tip="{x:Static res:Strings.Nav_Chat}">
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <PathIcon Data="{StaticResource IconChat}" Width="24" Height="24" HorizontalAlignment="Center" />
                                <TextBlock Classes="RailLabel LabelSmall" Text="{x:Static res:Strings.Nav_Chat}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Classes="M3NavigationRailItem" ToolTip.Tip="{x:Static res:Strings.Nav_Settings}">
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <PathIcon Data="{StaticResource IconSettings}" Width="24" Height="24" HorizontalAlignment="Center" />
                                <TextBlock Classes="RailLabel LabelSmall" Text="{x:Static res:Strings.Nav_Settings}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Panel>
            </DrawerPage.Drawer>

            <DrawerPage.DrawerFooter>
                <Border Padding="12,12" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,1,0,0">
                    <Panel>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsRail}">
                            <Button x:Name="ThemeToggleBtn" Classes="Icon"
                                    Click="OnThemeToggleClick" ToolTip.Tip="{x:Static res:Strings.Theme_ToggleTip}">
                                <PathIcon x:Name="ThemeIcon" Data="{StaticResource IconMoon}" Width="24" Height="24" />
                            </Button>
                        </StackPanel>
                        <Button x:Name="RailToggleBtn" Classes="Icon" HorizontalAlignment="Right"
                                Click="OnToggleRail" ToolTip.Tip="{x:Static res:Strings.Nav_CollapseTip}">
                            <PathIcon x:Name="CollapseChevron" Data="{StaticResource IconCaretLeft}"
                                      Width="24" Height="24" RenderTransformOrigin="50%,50%" />
                        </Button>
                    </Panel>
                </Border>
            </DrawerPage.DrawerFooter>

            <Border DataContext="{Binding $parent[Window].DataContext}">
                <TransitioningContentControl x:Name="PageHost"
                                             Content="{Binding CurrentPage}">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.15" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Border>

        </DrawerPage>
    </Grid>

</Window>
