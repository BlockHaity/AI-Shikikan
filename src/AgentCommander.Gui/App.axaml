<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgentCommander.Gui.App"
             xmlns:local="using:AgentCommander.Gui"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             >

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <theme:MaterialTheme />
        <materialIcons:MaterialIconStyles />
    </Application.Styles>

    <Application.Resources>
        <FontFamily x:Key="ContentControlThemeFontFamily">avares://AgentCommander.Gui/Assets/Fonts/#HarmonyOS Sans SC</FontFamily>
    </Application.Resources>
</Application>
